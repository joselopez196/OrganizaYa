# Puerto del servidor
PORT=4000

# Entorno (development | production)
NODE_ENV=development

# Clave secreta para JWT
JWT_SECRET=super_secret_jwt_key_organizaya_change_this_in_production
JWT_EXPIRES_IN=30d

# Base de datos PostgreSQL / Supabase
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/organizaya

# Orígenes CORS permitidos (separados por coma)
ALLOWED_ORIGINS=https://joselopez196.github.io,http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500
